{
  "name": "globewest-qa-2026",
  "version": "1.0.0",
  "description": "Accessibility and Functional Journey QA Automation for GlobeWest Storefront (2026)",
  "main": "index.js",
  "scripts": {
    "postinstall": "chmod +x node_modules/.bin/* 2>/dev/null || true",
    "test": "playwright test --project=desktop-chrome",
    "test:accessibility": "playwright test tests/accessibility.spec.js --project=desktop-chrome",
    "test:journeys": "playwright test tests/journeys.spec.js --project=desktop-chrome",
    "test:staging-nvda": "playwright test tests/staging-nvda.spec.js --project=desktop-chrome --headed --workers=1 --timeout=240000",
    "test:nvda": "npm run test:staging-nvda",
    "test:outdoor-nvda": "playwright test tests/outdoor-nvda.spec.js --project=desktop-chrome --headed --workers=1 --timeout=300000",
    "test:lighthouse": "playwright test tests/lighthouse.spec.js --project=desktop-chrome",
    "test:verify-all": "node run_and_verify_scores.js",
    "verify:scores": "node verify_scores.js",
    "test:ticket1": "playwright test tests/ticket1-us-theme-copy.spec.js --project=desktop-chrome",
    "test:ticket2": "playwright test tests/ticket2-us-store-scope-config.spec.js --project=desktop-chrome",
    "test:ticket3": "playwright test tests/ticket3-au-regression-safeguards.spec.js --project=desktop-chrome",
    "test:ticket4": "playwright test tests/ticket4-us-cms-structure.spec.js --project=desktop-chrome",
    "test:ticket4:headed": "playwright test tests/ticket4-us-cms-structure.spec.js --project=desktop-chrome --headed",
    "test:ticket4:admin": "playwright test tests/ticket4-us-cms-structure.spec.js -g \"TC-US-CMS-01|TC-US-CMS-02|TC-US-CMS-03\" --project=desktop-chrome --headed",
    "test:ticket4:functional": "playwright test tests/ticket4-us-cms-structure.spec.js -g \"TC-US-CMS-04-to-12\" --project=desktop-chrome --headed",
    "test:ticket5": "playwright test tests/ticket5-us-header-comparison.spec.js --project=desktop-chrome",
    "test:ticket5:headed": "playwright test tests/ticket5-us-header-comparison.spec.js --project=desktop-chrome --headed",
    "comparison:ticket5": "python3 \"../Ticket 5 - Header/scripts/generate_header_comparison.py\"",
    "test:plp": "playwright test tests/plp-us-vs-au-comparison.spec.js --project=desktop-chrome",
    "test:plp:headed": "playwright test tests/plp-us-vs-au-comparison.spec.js --project=desktop-chrome --headed",
    "test:plp:figma": "playwright test tests/plp-figma-verification.spec.js --project=desktop-chrome",
    "test:plp:figma:headed": "playwright test tests/plp-figma-verification.spec.js --project=desktop-chrome --headed",
    "figma:open": "node scripts/open_figma_interactive.js",
    "figma:designs": "node scripts/navigate_to_figma_designs.js",
    "test:homepage": "playwright test tests/ticket-homepage-audit.spec.js --project=desktop-chrome",
    "test:homepage:headed": "playwright test tests/ticket-homepage-audit.spec.js --project=desktop-chrome --headed",
    "figma:my-quotes": "node scripts/open_figma_my_quotes.js",
    "retest:my-quotes": "node Sprint-3/Ticket_41794529_My_Account_Quotes/scripts/retest_my_quotes_live.js",
    "test:tickets-all": "playwright test tests/ticket1-us-theme-copy.spec.js tests/ticket2-us-store-scope-config.spec.js tests/ticket3-au-regression-safeguards.spec.js tests/ticket4-us-cms-structure.spec.js --project=desktop-chrome",
    "report": "playwright show-report --port 9325",
    "zip:report": "node -e \"const {execSync}=require('child_process');process.platform==='win32'?execSync('powershell.exe -Command \\\"Compress-Archive -Path playwright-report/* -DestinationPath playwright-report.zip -Force\\\"',{stdio:'inherit'}):execSync('zip -q -r playwright-report.zip playwright-report/ -x \\\"*/.*\\\"',{stdio:'inherit'})\""
  },
  "keywords": [
    "accessibility",
    "playwright",
    "wcag-2.2",
    "axe-core",
    "guidepup",
    "nvda"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@guidepup/playwright": "^0.13.0",
    "@playwright/test": "^1.60.0",
    "lighthouse": "^13.4.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3"
  }
}
